{
  "manifest_version": 3,
  "name": "CyberShield URL Phishing Detector",
  "version": "1.0.0",
  "description": "Checks visited URLs against your local CyberShield detector and warns about suspicious results.",
  "permissions": ["webNavigation", "storage", "notifications", "tabs"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:5000/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "CyberShield scan status", "default_popup": "popup.html"},
  "icons": {}
}
